# Public base URL of the portal (https in production)
BASE_URL=https://portal.example.com
PORT=3000
DATABASE_PATH=./data/cpr.sqlite
SESSION_TTL_SECONDS=28800

# Google OAuth (Google Cloud console > APIs & Services > Credentials > OAuth client ID, "Web application")
# Authorized redirect URI must equal GOOGLE_REDIRECT_URI (default: BASE_URL + /auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# SAML 2.0 Service Provider. PEM contents (use \n for line breaks) or a *_FILE path.
# SAML_SP_ENTITY_ID defaults to BASE_URL + /auth/saml/metadata
# SAML_SP_ENTITY_ID=
SAML_SP_PRIVATE_KEY=
SAML_SP_CERT=
# SAML_SP_PRIVATE_KEY_FILE=
# SAML_SP_CERT_FILE=

# Bearer token for the IdP administration API (/admin/idps). The API is disabled when empty.
ADMIN_API_TOKEN=
